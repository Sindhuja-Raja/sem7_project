# Copy this file to ".env" and fill in the keys you have.
# The app runs with none of these set - OpenAlex, Crossref and arXiv
# need no key. CORE and Semantic Scholar are skipped gracefully if their
# keys are missing, and LLM features (query expansion, summaries,
# relevance explanations) are disabled without GROQ_API_KEY.

# Free key from https://console.groq.com/keys - powers query expansion,
# paper summaries and relevance explanations.
GROQ_API_KEY=

# Any Groq-hosted chat model, e.g. openai/gpt-oss-120b or qwen/qwen3.8-27b
# (see https://api.groq.com/openai/v1/models for what's currently available -
# Groq periodically retires older models)
GROQ_MODEL=openai/gpt-oss-120b

# Free key from https://core.ac.uk/services/api - required for the CORE source.
CORE_API_KEY=

# Optional - raises your Semantic Scholar rate limit. Request at
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional - sent to OpenAlex/Crossref's "polite pool" for better reliability.
CONTACT_EMAIL=
